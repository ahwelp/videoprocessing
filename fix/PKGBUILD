# Maintainer: Your Name <your@email>
# Modified version of ffmpeg7.1 AUR package to include ffmpeg binary installation

_pkgname=ffmpeg
pkgname=${_pkgname}7.1
pkgver=7.1.2
pkgrel=1
pkgdesc="Complete solution to record, convert and stream audio and video (FFmpeg ${pkgver} with executable)"
arch=(x86_64)
url="https://ffmpeg.org"
license=('GPL-3.0-only')

depends=(
  alsa-lib aom avisynthplus bzip2 frei0r-plugins
  gmp jack lame libass libbluray libdrm libglvnd
  libiec61883 libjpeg-turbo libmodplug libpng librsvg
  libsoxr libssh libtheora libva libvdpau libvorbis
  libvpx libwebp libx11 libxcb libxml2 libxv ocl-icd
  opencore-amr openjpeg2 opus rav1e rubberband sdl2
  snappy speex srt svt-av1 v4l-utils vapoursynth
  vid.stab vmaf vulkan-icd-loader vmaf libx264 libx265
  libzimg libzmq
)

makedepends=(
  git nasm yasm vim cmake ninja meson
)

optdepends=('ffplay: For ffplay playback tool')

source=(
  "git+https://git.ffmpeg.org/ffmpeg.git?signed#tag=n${pkgver}"
  "fix_build_with_v4l2_1.30.patch"
  "0001-Add-av_stream_get_first_dts-for-Chromium.patch"
  "0002-avcodec-libsvtav1-unbreak-build-with-latest-svtav1.patch"
  "0003-ffmpeg-glslang16-fix.patch"
)

sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

validpgpkeys=('B18E8928B3948D64')  # FFmpeg signing key

prepare() {
  cd ffmpeg

  patch -Np1 -i ../fix_build_with_v4l2_1.30.patch
  patch -Np1 -i ../0001-Add-av_stream_get_first_dts-for-Chromium.patch
  patch -Np1 -i ../0002-avcodec-libsvtav1-unbreak-build-with-latest-svtav1.patch
  patch -Np1 -i ../0003-ffmpeg-glslang16-fix.patch
}

build() {
  cd ffmpeg

  ./configure \
    --prefix=/usr \
    --disable-debug \
    --enable-gpl \
    --enable-version3 \
    --enable-nonfree \
    --enable-shared \
    --enable-libx264 \
    --enable-libx265 \
    --enable-libvpx \
    --enable-libwebp \
    --enable-libass \
    --enable-libfreetype \
    --enable-libvorbis \
    --enable-libopus \
    --enable-libmp3lame \
    --enable-libtheora \
    --enable-libspeex \
    --enable-libvidstab \
    --enable-libvmaf \
    --enable-libsvtav1 \
    --enable-librav1e \
    --enable-libzimg \
    --enable-libfdk-aac \
    --enable-libopencore-amrnb \
    --enable-libopencore-amrwb \
    --enable-libopenjpeg \
    --enable-libsoxr \
    --enable-opengl \
    --enable-libssh \
    --enable-libxml2 \
    --enable-libaom \
    --enable-libsnappy \
    --enable-librubberband

  make
}

package() {
  cd ffmpeg
  make DESTDIR="$pkgdir" install

  # Garantir que os binários existam
  install -Dm755 ffmpeg "$pkgdir/usr/bin/ffmpeg"
  install -Dm755 ffprobe "$pkgdir/usr/bin/ffprobe"
  [[ -f ffplay ]] && install -Dm755 ffplay "$pkgdir/usr/bin/ffplay"
}


